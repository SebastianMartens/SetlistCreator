@page "/"
@rendermode InteractiveServer
@using SetlistCreator.Backend.Models
@using SetlistCreator.Backend.Services
@inject ISetlistService SetlistService
@inject IJSRuntime JS

<PageTitle>Setlist Creator</PageTitle>

<h1 class="setlist-no-print">Setlist Creator</h1>

<p class="setlist-no-print">Create a live show setlist by adding songs from albums, adding manual songs, and inserting breaks.</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{    
    <div class="alert alert-success setlist-no-print" role="alert">@successMessage</div>
}

<div class="row g-4">
    <div class="col-md-6 setlist-no-print">
        <h2>Album songs</h2>
        <div class="mb-2">
            <label class="form-label" for="songSearch">Search songs</label>
            <input id="songSearch" class="form-control" @bind="songSearchQuery" @bind:event="oninput" placeholder="Type to search across all albums…" />
        </div>
        @if (!string.IsNullOrWhiteSpace(songSearchQuery))
        {
            @if (!songSearchResults.Any())
            {
                <p class="text-muted">No songs found.</p>
            }
            else
            {
                <ul class="list-group mb-2" style="max-height:240px;overflow-y:auto;">
                    @foreach (var song in songSearchResults)
                    {
                        var alreadyAdded = setlistSongTitles.Contains(song.Title);
                        <li class="list-group-item d-flex justify-content-between align-items-center @(alreadyAdded ? "text-muted" : "")">
                            <span>
                                <span class="fw-semibold">@song.Title</span>
                                <span class="text-muted small"> — @song.AlbumName (@FormatDuration(song.Duration))</span>
                            </span>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AddSearchedSong(song)">Add</button>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="mb-2">
                <label class="form-label" for="albumSelect">Album</label>
                <select id="albumSelect" class="form-select" @bind="selectedAlbumId" @bind:after="OnAlbumChanged">
                    @foreach (var album in albums)
                    {
                        <option value="@album.Id">@album.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label" for="songSelect">Song</label>
                <select id="songSelect" class="form-select" @bind="selectedSongId">
                    @foreach (var song in albumSongs)
                    {
                        <option value="@song.Id" style="@(setlistSongTitles.Contains(song.Title) ? "color:#adb5bd;" : "")">@song.Title (@FormatDuration(song.Duration))</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" @onclick="AddSongFromAlbum">Add selected song</button>
        }

        <h2 class="mt-4">Break</h2>
        <div class="mb-2">
            <label class="form-label" for="breakName">Break name</label>
            <input id="breakName" class="form-control" @bind="breakName" />
        </div>
        <div class="mb-2">
            <label class="form-label" for="breakMinutes">Duration (minutes)</label>
            <input id="breakMinutes" class="form-control" type="number" min="1" @bind="breakMinutes" />
        </div>
        <button class="btn btn-outline-secondary" @onclick="AddBreak">Add break</button>

        <h2 class="mt-4">Manual song</h2>
        <div class="mb-2">
            <label class="form-label" for="manualSongTitle">Song title</label>
            <input id="manualSongTitle" class="form-control" @bind="manualSongTitle" />
        </div>
        <div class="mb-2">
            <label class="form-label" for="manualSongMinutes">Duration (minutes)</label>
            <input id="manualSongMinutes" class="form-control" type="number" min="1" @bind="manualSongMinutes" />
        </div>
        <button class="btn btn-outline-primary" @onclick="AddManualSong">Add manual song</button>
    </div>

    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="setlist-no-print">Current setlist</h2>
            <button class="btn btn-outline-secondary btn-sm setlist-no-print"
                    @onclick="PrintSetlist"
                    disabled="@(setlist.Items.Count == 0)"
                    title="@(setlist.Items.Count == 0 ? "Add at least one setlist item to print." : "Print setlist")">
                Print setlist
            </button>
        </div>
        <div class="setlist-print-header">
            <h2>@(string.IsNullOrWhiteSpace(setlist.VenueName) ? "Setlist" : setlist.VenueName)</h2>
            @if (setlist.GigDate.HasValue)
            {
                <p>@setlist.GigDate.Value.ToString("d MMMM yyyy")</p>
            }
        </div>
        <div class="mb-2 setlist-no-print">
            <label class="form-label" for="venueName">Venue name</label>
            <input id="venueName" class="form-control" @bind="setlist.VenueName" />
        </div>
        <div class="mb-2 setlist-no-print">
            <label class="form-label" for="gigDate">Gig date</label>
            <InputDate id="gigDate" class="form-control" @bind-Value="setlist.GigDate" />
        </div>
        @if (setlist.Items.Count == 0)
        {
            <p>No items added yet.</p>
        }
        else
        {
            var songNumber = 0;
            <ul class="list-group setlist-print-content">
                @for (var i = 0; i < setlist.Items.Count; i++)
                {
                    var item = setlist.Items[i];
                    var index = i;
                    if (item.Type == SetlistItemType.Song)
                    {
                        songNumber++;
                        <li class="list-group-item d-flex justify-content-between align-items-center @(dragOverIndex == index ? "drag-target" : "")"
                            draggable="true"
                            @ondragstart="() => OnDragStart(index)"
                            @ondragover="() => OnDragOver(index)"
                            @ondragover:preventDefault="true"
                            @ondrop="() => OnDrop(index)"
                            @ondragend="OnDragEnd">
                            <span class="d-flex align-items-center gap-2">
                                <span class="drag-handle setlist-no-print" title="Drag to reorder">⠿</span>
                                <span><span class="fw-semibold me-2">@($"{songNumber}.")</span>@item.Name</span>
                            </span>
                            <span class="d-flex align-items-center gap-2">
                                <span>@FormatDuration(item.Duration)</span>
                                <button class="btn btn-sm btn-outline-danger setlist-no-print" @onclick="() => RemoveItem(index)" title="Remove">&#x2715;</button>
                            </span>
                        </li>
                    }
                    else
                    {
                        <li class="list-group-item d-flex align-items-center gap-2 setlist-break-item @(dragOverIndex == index ? "drag-target" : "")"
                            draggable="true"
                            @ondragstart="() => OnDragStart(index)"
                            @ondragover="() => OnDragOver(index)"
                            @ondragover:preventDefault="true"
                            @ondrop="() => OnDrop(index)"
                            @ondragend="OnDragEnd">
                            <span class="drag-handle setlist-no-print" title="Drag to reorder">⠿</span>
                            <div class="setlist-break-line" style="flex:1">
                                <hr />
                                <span class="text-muted">@item.Name (@FormatDuration(item.Duration))</span>
                                <hr />
                            </div>
                            <button class="btn btn-sm btn-outline-danger setlist-no-print" @onclick="() => RemoveItem(index)" title="Remove">&#x2715;</button>
                        </li>
                    }
                }
            </ul>
        }
        <button class="btn btn-success mt-2 setlist-no-print" @onclick="SaveSetlist" disabled="@(setlist.Items.Count == 0)">Save setlist</button>
        <p class="fw-bold mt-2 setlist-no-print">Total duration (songs + breaks): @FormatDuration(SetlistService.CalculateTotalDuration(setlist))</p>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "setlistId")]
    public Guid? SetlistId { get; set; }

    private IReadOnlyList<Album> albums = [];
    private IReadOnlyList<Song> albumSongs = [];
    private Setlist setlist = new();
    private Guid selectedAlbumId;
    private Guid selectedSongId;
    private string manualSongTitle = string.Empty;
    private int manualSongMinutes = 4;
    private string breakName = "Break";
    private int breakMinutes = 1;
    private string songSearchQuery = string.Empty;
    private HashSet<string> setlistSongTitles =>
        setlist.Items
               .Where(i => i.Type == SetlistItemType.Song)
               .Select(i => i.Name)
               .ToHashSet();
    private IEnumerable<Song> songSearchResults =>
        albums.SelectMany(a => a.Songs)
              .Where(s => s.Title.Contains(songSearchQuery, StringComparison.OrdinalIgnoreCase))
              .Take(25);
    private string? errorMessage;
    private string? successMessage;
    private Guid? loadedSetlistId;
    private int? dragFromIndex;
    private int? dragOverIndex;

    protected override void OnInitialized()
    {
        albums = SetlistService.GetAlbums();

        if (albums.Count == 0)
        {
            return;
        }

        selectedAlbumId = albums[0].Id;
        UpdateAlbumSongs();
    }

    private void OnAlbumChanged() => UpdateAlbumSongs();

    protected override void OnParametersSet()
    {
        if (SetlistId is not Guid setlistId || loadedSetlistId == setlistId)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            setlist = SetlistService.GetSavedSetlist(setlistId);
            loadedSetlistId = setlistId;
            successMessage = "Saved setlist opened in builder.";
        }
        catch (KeyNotFoundException)
        {
            errorMessage = "Unable to load setlist. It may have been deleted or does not exist.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void UpdateAlbumSongs()
    {
        albumSongs = SetlistService.GetSongsForAlbum(selectedAlbumId);
        selectedSongId = albumSongs.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private void AddSongFromAlbum()
    {
        errorMessage = null;
        successMessage = null;

        var song = albumSongs.FirstOrDefault(s => s.Id == selectedSongId);
        if (song is null)
        {
            errorMessage = "Please select a song to add.";
            return;
        }

        SetlistService.AddSong(setlist, song);
    }

    private void AddSearchedSong(Song song)
    {
        errorMessage = null;
        successMessage = null;
        SetlistService.AddSong(setlist, song);
    }

    private void AddManualSong()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var manualSong = SetlistService.CreateManualSong(manualSongTitle, TimeSpan.FromMinutes(manualSongMinutes));
            SetlistService.AddSong(setlist, manualSong);
            manualSongTitle = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void AddBreak()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            SetlistService.AddBreak(setlist, breakName, TimeSpan.FromMinutes(breakMinutes));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void SaveSetlist()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            SetlistService.SaveSetlist(setlist);
            loadedSetlistId = setlist.Id;
            successMessage = "Setlist saved.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task PrintSetlist()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void RemoveItem(int index) => setlist.Items.RemoveAt(index);

    private void OnDragStart(int index) => dragFromIndex = index;

    private void OnDragOver(int index) => dragOverIndex = index;

    private void OnDrop(int index)
    {
        if (dragFromIndex is int from && from != index)
        {
            var item = setlist.Items[from];
            setlist.Items.RemoveAt(from);
            setlist.Items.Insert(from < index ? index - 1 : index, item);
        }
        dragFromIndex = null;
        dragOverIndex = null;
    }

    private void OnDragEnd()
    {
        dragFromIndex = null;
        dragOverIndex = null;
    }

    private static string FormatDuration(TimeSpan duration) => $"{(int)duration.TotalMinutes:00}:{duration.Seconds:00}";
}
