@page "/print/{SetlistId:guid}"
@rendermode InteractiveServer
@using SetlistCreator.Backend.Models
@using SetlistCreator.Backend.Services
@inject ISetlistService SetlistService
@inject IJSRuntime JS

<PageTitle>@(setlist?.VenueName is { Length: > 0 } v ? v : "Setlist") — Print</PageTitle>

@if (setlist is null)
{
    <p>Setlist not found. <a href="/">Back to builder</a></p>
}
else
{
    <div class="print-controls">
        <button class="btn btn-primary" @onclick="Print">Print</button>
        <a class="btn btn-outline-secondary" href="/?setlistId=@SetlistId">Back to editor</a>
    </div>

    <div class="setlist-print-page">
        <div class="setlist-print-header">
            <h2>@(string.IsNullOrWhiteSpace(setlist.VenueName) ? "Setlist" : setlist.VenueName)</h2>
            @if (!string.IsNullOrWhiteSpace(GetPrintHeaderDetails()))
            {
                <p>@GetPrintHeaderDetails()</p>
            }
        </div>

        <ul class="list-group setlist-print-content">
            @{ var songNumber = 0; }
            @foreach (var item in setlist.Items)
            {
                if (item.Type == SetlistItemType.Song)
                {
                    songNumber++;
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><span class="fw-semibold me-2">@($"{songNumber}.")</span>@item.Name</span>
                        <span>@FormatDuration(item.Duration)</span>
                    </li>
                }
                else
                {
                    <li class="list-group-item d-flex align-items-center gap-2 setlist-break-item">
                        <div class="setlist-break-line" style="flex:1">
                            <hr />
                            <span class="text-muted">@item.Name (@FormatDuration(item.Duration))</span>
                            <hr />
                        </div>
                    </li>
                }
            }
        </ul>
    </div>
}

@code {
    [Parameter] public Guid SetlistId { get; set; }

    private Setlist? setlist;

    protected override void OnInitialized()
    {
        try { setlist = SetlistService.GetSavedSetlist(SetlistId); }
        catch { setlist = null; }
    }

    private async Task Print() =>
        await JS.InvokeVoidAsync("setlistPrint", setlist?.Items.Count ?? 0);

    private string GetPrintHeaderDetails()
    {
        if (setlist is null)
        {
            return string.Empty;
        }

        var details = new List<string>();

        if (setlist.GigDate.HasValue)
        {
            details.Add(setlist.GigDate.Value.ToString("d MMMM yyyy"));
        }

        details.Add($"Total: {FormatDuration(SetlistService.CalculateTotalDuration(setlist))}");

        return string.Join(" | ", details);
    }

    private static string FormatDuration(TimeSpan d) =>
        $"{(int)d.TotalMinutes:00}:{d.Seconds:00}";
}
